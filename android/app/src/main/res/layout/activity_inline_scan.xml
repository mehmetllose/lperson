<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:id="@+id/inline_scan_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="22dp"
        android:background="@drawable/widget_inline_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_inline_short"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.camera.view.PreviewView
            android:id="@+id/inline_preview"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/inline_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hazırlanıyor…"
            android:textColor="#FFE8E8E8"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/inline_torch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Flaş" />

            <Button
                android:id="@+id/inline_close"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kapat" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/inline_result_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="28dp"
        android:background="@drawable/inline_result_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/inline_result_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/inline_result_icon_bg"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FF4ADE80"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inline_result_kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.12"
            android:text="GİRİŞ"
            android:textAllCaps="true"
            android:textColor="#FF4ADE80"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inline_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Giriş"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inline_result_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#FFE8E8E8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/inline_result_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="#FF9AA39C"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/inline_result_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#FF4ADE80"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inline_result_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#FFB7C4BC"
            android:textSize="14sp" />
    </LinearLayout>

    <WebView
        android:id="@+id/inline_web"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />
</FrameLayout>
